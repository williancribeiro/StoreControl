{
  "ConnectionStrings": {
    "StoreControl": ""
  },
  "Messaging": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "TopologyPrefix": "storecontrol",
    "ConnectionTimeoutMilliseconds": 2000,
    "RecoveryIntervalSeconds": 5,
    "OutboxPollingMilliseconds": 1000,
    "OutboxBatchSize": 20,
    "OutboxLeaseSeconds": 30,
    "ConsumerPrefetch": 8,
    "RetryDelaysMilliseconds": [5000, 30000, 120000]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "StoreControl.Worker"
    }
  }
}
