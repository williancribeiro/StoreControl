{
  "ConnectionStrings": {
    "StoreControl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "StoreControl.Api",
      "Audience": "StoreControl.Web",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 7,
      "CookieSecure": true
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "StoreControl.Api"
    }
  },
  "AllowedHosts": "*"
}
