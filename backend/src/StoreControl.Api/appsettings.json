{
  "ConnectionStrings": {
    "StoreControl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "StoreControl.Api",
      "Audience": "StoreControl.Web",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 7,
      "CookieSecure": true
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cache": {
    "Enabled": false,
    "RedisConnection": "",
    "KeyPrefix": "storecontrol:local",
    "DashboardTtlSeconds": 30,
    "CategoriesTtlSeconds": 300,
    "TimeoutMilliseconds": 500
  },
  "Messaging": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "TopologyPrefix": "storecontrol",
    "ConnectionTimeoutMilliseconds": 2000,
    "RecoveryIntervalSeconds": 5,
    "OutboxPollingMilliseconds": 1000,
    "OutboxBatchSize": 20,
    "OutboxLeaseSeconds": 30,
    "ConsumerPrefetch": 8,
    "RetryDelaysMilliseconds": [5000, 30000, 120000]
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "StoreControl.Api"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
