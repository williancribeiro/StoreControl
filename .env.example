# Não adicione segredos a este arquivo versionado.
# Gere o .env ignorado pelo Git com:
#   .\scripts\Initialize-LocalEnvironment.ps1 -EnableDemoData
MSSQL_SA_PASSWORD=
STORECONTROL_DATABASE=StoreControl
RABBITMQ_DEFAULT_USER=storecontrol
RABBITMQ_DEFAULT_PASS=
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_KEY_PREFIX=storecontrol:local
CACHE_DASHBOARD_TTL_SECONDS=30
CACHE_CATEGORIES_TTL_SECONDS=300
CACHE_TIMEOUT_MILLISECONDS=500
JWT_SIGNING_KEY=

# O seed demonstrativo é opt-in. As senhas também devem ficar somente no .env local.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Portas publicadas em localhost.
SQLSERVER_PORT=1433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=5090
WEB_PORT=5173
